<mxfile host="app.diagrams.net"><diagram name="UML Class Diagram" id="uml"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;div style=&quot;text-align:center;padding:4px&quot;&gt;&lt;b&gt;Main&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;padding:2px 6px&quot;&gt;- users : ArrayList&amp;lt;User&amp;gt;&lt;br&gt;- products : ArrayList&amp;lt;Product&amp;gt;&lt;br&gt;- orders : ArrayList&amp;lt;Order&amp;gt;&lt;br&gt;- sc : Scanner&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;padding:2px 6px&quot;&gt;&lt;u&gt;+ main(args : String[]) : void&lt;/u&gt;&lt;br&gt;- login() : void&lt;br&gt;- customerMenu(customer : Customer) : void&lt;br&gt;- placeOrder(customer : Customer) : void&lt;br&gt;- employeeMenu() : void&lt;br&gt;- addProduct() : void&lt;br&gt;- addUser() : void&lt;br&gt;- listProducts() : void&lt;br&gt;- listUsers() : void&lt;br&gt;- findProduct(id : int) : Product&lt;br&gt;- readNumber(text : String) : int&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="560" y="0" width="360" height="295" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;text-align:center;padding:4px&quot;&gt;&lt;b&gt;User&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;padding:2px 6px&quot;&gt;- id : int&lt;br&gt;- name : String&lt;br&gt;- email : String&lt;br&gt;- password : String&lt;br&gt;- role : String&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;padding:2px 6px&quot;&gt;+ getters / setters&lt;br&gt;+ displayInfo() : void&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#dae8fc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="300" height="175" as="geometry"/></mxCell><mxCell id="c4" val