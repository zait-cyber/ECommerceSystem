<mxfile host="app.diagrams.net"><diagram name="UML Class Diagram" id="uml"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;div style=&quot;text-align:center;padding:4px&quot;&gt;«abstract»&lt;br&gt;&lt;i&gt;&lt;b&gt;User&lt;/b&gt;&lt;/i&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;padding:2px 6px&quot;&gt;- id : int&lt;br&gt;- name : String&lt;br&gt;- email : String&lt;br&gt;- password : String&lt;br&gt;- role : Role&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;padding:2px 6px&quot;&gt;+ checkPassword(password) : boolean&lt;br&gt;&lt;i&gt;+ displayInfo() : void&lt;/i&gt;&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#dae8fc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1240" y="470" width="300" height="175" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;text-align:center;padding:4px&quot;&gt;&lt;b&gt;Customer&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;padding:2px 6px&quot;&gt;- address : String&lt;br&gt;- phone : String&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;padding:2px 6px&quot;&gt;+ displayInfo() : void&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#dae8fc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="760" width="300" height="115" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;text-align:center;padding:4px&quot;&gt;&lt;b&gt;Employee&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;padding:2px 6px&quot;&gt;- position : String&lt;br&gt;- salary : double&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;padding:2px 6px&quot;&gt;+ displayInfo() : void&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#dae8fc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1400" y="760" width="300" height="115" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style=&quot;text-align:center;padding:4px&quot;&gt;«enumeration»&lt;br&gt;&lt;b&gt;Role&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;padding:2px 6px&quot;&gt;CUSTOMER&lt;br&gt;EMPLOYEE&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#dae8fc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1560" y="470" width="300" height="100" as="geometry"/></mxCell><mxCell id="c6" value="&lt;div style=&quot;text-align:center;padding:4px&quot;&gt;«abstract»&lt;br&gt;&lt;i&gt;&lt;b&gt;Product&lt;/b&gt;&lt;/i&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;padding:2px 6px&quot;&gt;- id : int&lt;br&gt;- name : String&lt;br&gt;- price : double&lt;br&gt;- stockQuantity : int&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;padding:2px 6px&quot;&gt;+ displayInfo() : void&lt;br&gt;+ reduceStock(qty) : void&lt;br&gt;&lt;i&gt;+ getCategory() : String&lt;/i&gt;&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#dae8fc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="120" y="470" width="300" height="175" as="geometry"/></mxCell><mxCell id="c7" value="&lt;div style=&quot;text-align:center;padding:4px&quot;&gt;&lt;b&gt;Book&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;padding:2px 6px&quot;&gt;- author : String&lt;br&gt;- pages : int&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;padding:2px 6px&quot;&gt;+ getCategory() : String&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#dae8fc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="-220" y="760" width="300" height="115" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style=&quot;text-align